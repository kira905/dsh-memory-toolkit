{
  "name": "@kira905/dsh-memory-toolkit",
  "version": "0.5.2",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH 记忆面工具集：独立向量记忆引擎（增量同步 / 混合召回 / 文档索引）+ 记忆库只读体检工具链 + 本地记忆插件 fork（含来源血缘 / 记忆时效 / 删留痕 / 血缘回填）+ persona 记忆体检",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "vector-search",
    "embeddings",
    "sqlite",
    "fts5",
    "plugin",
    "provenance",
    "ttl"
  ],
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "kira905",
  "homepage": "https://github.com/kira905/dsh-memory-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kira905/dsh-memory-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/kira905/dsh-memory-toolkit/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./dsh-memory-local": "./dsh-memory-local/lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-memory-audit": "./persona-memory-audit.mjs",
    "dsh-memory-summary": "./memory-db-tools/list-memory-summary.mjs",
    "dsh-memory-export": "./memory-db-tools/audit-export.mjs",
    "dsh-memory-lineage": "./dsh-memory-local/lib/lineage-backfill.mjs",
    "dsh-mem-band-sentinel": "./memory-engine/cli/band-sentinel.mjs",
    "dsh-mem-distill": "./memory-engine/cli/distill.mjs",
    "dsh-mem-distill-rollback": "./memory-engine/cli/distill-rollback.mjs",
    "dsh-mem-distill-sessions": "./memory-engine/cli/distill-sessions.mjs",
    "dsh-mem-doc-index": "./memory-engine/cli/doc-index.mjs",
    "dsh-mem-doc-index-rebuild": "./memory-engine/cli/doc-index-rebuild.mjs",
    "dsh-mem-domain-tags": "./memory-engine/cli/domain-tags.mjs",
    "dsh-mem-layer-migrate": "./memory-engine/cli/layer-migrate.mjs",
    "dsh-mem-layer-move": "./memory-engine/cli/layer-move.mjs",
    "dsh-mem-pitfall-hook": "./memory-engine/cli/pitfall-hook.mjs",
    "dsh-mem-recall": "./memory-engine/cli/recall.mjs",
    "dsh-mem-selfcheck": "./memory-engine/cli/selfcheck.mjs",
    "dsh-mem-serve-start": "./memory-engine/cli/serve-start.mjs",
    "dsh-mem-sweep": "./memory-engine/cli/sweep.mjs",
    "dsh-mem-sync": "./memory-engine/cli/sync.mjs"
  },
  "files": [
    "cordis.patch.yml",
    "memory-engine/",
    "!memory-engine/test/",
    "memory-db-tools/",
    "!memory-db-tools/_test/",
    "dsh-memory-local/",
    "!dsh-memory-local/test/",
    "lib/",
    "persona-memory-audit.mjs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "help": "node memory-db-tools/audit-export.mjs --help",
    "audit": "node persona-memory-audit.mjs",
    "test": "node memory-db-tools/_test/test-memory-scope.mjs && node memory-db-tools/_test/test-mem-conflict.mjs --all && node memory-db-tools/memory-snapshot.mjs --selftest && node dsh-memory-local/test/schema-migrate.test.mjs && node --test dsh-memory-local/test/until-expiry.test.mjs dsh-memory-local/test/source-ids.test.mjs dsh-memory-local/test/pointer-stamp.test.mjs && node dsh-memory-local/test/test-memory-lineage-loop.mjs && node dsh-memory-local/test/test-wiring.mjs && node memory-engine/test/run.mjs",
    "test:scope": "node memory-db-tools/_test/test-memory-scope.mjs",
    "test:conflict": "node memory-db-tools/_test/test-mem-conflict.mjs --all",
    "test:snapshot": "node memory-db-tools/memory-snapshot.mjs --selftest",
    "test:wiring": "node dsh-memory-local/test/test-wiring.mjs",
    "test:engine": "node memory-engine/test/run.mjs",
    "test:lineage": "node dsh-memory-local/test/test-memory-lineage-loop.mjs",
    "test:plugin": "node dsh-memory-local/test/regression.mjs",
    "test:recall": "npm run test:plugin && node --test dsh-memory-local/test/s2b.test.mjs dsh-memory-local/test/visible-injections.test.mjs",
    "test:memory": "node --test dsh-memory-local/test/until-expiry.test.mjs dsh-memory-local/test/source-ids.test.mjs dsh-memory-local/test/pointer-stamp.test.mjs"
  }
}
